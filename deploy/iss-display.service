[Unit]
Description=ISS Tracker Display
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
WorkingDirectory=%h/iss-tracker
ExecStart=%h/iss-tracker/.venv/bin/python -m iss_display.app.main
EnvironmentFile=%h/iss-tracker/.env

# Watchdog: systemd kills and restarts service if no ping within this window
WatchdogSec=60s

# Cold start (globe generation + RGB565 conversion) can take several minutes
# on a Pi 3; READY=1 is only sent once the main loop is up. Warm starts with
# the RGB565 disk cache are seconds.
TimeoutStartSec=15min

# Restart policy: 5s -> 10s -> 20s -> 40s -> 60s (5 steps)
Restart=always
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=60

# Resource limits (requires cgroup_enable=memory in cmdline.txt).
# At 480 frames the RGB565 frames alone are ~147 MB, and a cold cache
# rebuild holds ~221 MB of RGB source frames while converting (computed
# from the frame sizes, not measured). The previous 200M/250M limits kept
# the service permanently in memory.high reclaim, thrashing ~230 MB of
# swap on the SD card.
MemoryMax=450M
MemoryHigh=380M

# Graceful shutdown
TimeoutStopSec=10
KillSignal=SIGTERM

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iss-display

[Install]
WantedBy=default.target
