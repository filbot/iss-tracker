[Unit]
Description=ISS Tracker Display
# No network-online.target ordering: user units can't see system targets,
# so it never had an effect. The app starts offline and shows NO LINK
# until its first successful fetch.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
WorkingDirectory=%h/iss-tracker
ExecStart=%h/iss-tracker/.venv/bin/python -m iss_display.app.main
EnvironmentFile=%h/iss-tracker/.env

# Watchdog: systemd kills and restarts service if no ping within this window
WatchdogSec=60s

# Cold start (globe generation + RGB565 conversion) can take several minutes
# on a Pi 3; READY=1 is only sent once the main loop is up. Warm starts with
# the RGB565 disk cache are seconds.
TimeoutStartSec=15min

# Restart policy: 5s -> 10s -> 20s -> 40s -> 60s (5 steps)
Restart=always
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=60

# Resource limits (requires cgroup_enable=memory in cmdline.txt).
# Measured on a Pi 3B at 480 frames: steady state is ~186 MB anon (147 MB
# of it RGB565 frames). A cold cache rebuild adds four ~105-120 MB render
# workers, so it sits at MemoryHigh and swaps up to ~300 MB, but finishes
# (~31 min, mostly thermal throttling). The previous 200M/250M limits kept
# the service permanently in memory.high reclaim, thrashing ~230 MB of
# swap on the SD card.
MemoryMax=450M
MemoryHigh=380M

# Graceful shutdown
TimeoutStopSec=10
KillSignal=SIGTERM

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iss-display

[Install]
WantedBy=default.target
