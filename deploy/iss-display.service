[Unit]
Description=ISS Tracker Display
# No network-online.target ordering: user units can't see system targets,
# so it never had an effect. The app starts offline and shows NO LINK
# until its first successful fetch.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
WorkingDirectory=%h/iss-tracker
ExecStart=%h/iss-tracker/.venv/bin/python -m iss_display.app.main
EnvironmentFile=%h/iss-tracker/.env

# Watchdog: systemd kills and restarts service if no ping within this window
WatchdogSec=60s

# READY=1 is sent once the main loop is up. Loading the committed globe
# frames takes about a second; the slow part is the first ISS and crew
# fetches, which can take ~30s against a dead network before giving up.
TimeoutStartSec=90s

# Restart policy: 5s -> 10s -> 20s -> 40s -> 60s (5 steps)
Restart=always
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=60

# Resource limits (requires cgroup_enable=memory in cmdline.txt).
# Measured on a Pi 3B at 480 frames: about 80 MB for the service, 48 MB
# of it the globe frames. These limits were sized for the old on-device
# globe build and now only catch a leak.
MemoryMax=450M
MemoryHigh=380M

# Graceful shutdown
TimeoutStopSec=10
KillSignal=SIGTERM

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iss-display

[Install]
WantedBy=default.target
